# Copy to .env (gitignored). Settings use the RAG_ prefix; API keys do not.

OPENROUTER_API_KEY=sk-or-...

# Required with the default openrouter backend; the API refuses to start without it.
# Pick one from https://openrouter.ai/models?q=free. Free models are withdrawn or
# rate-limited often, so there is no default; change this line when one stops working.
RAG_OPENROUTER_MODEL=

# Optional: use Claude instead.
# RAG_LLM_BACKEND=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
